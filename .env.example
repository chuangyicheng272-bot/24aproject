# 可選：IoT API 保護。設定後，ESP32/攝影機須帶 X-API-Key Header。
IOT_API_KEY=change-me
CORS_ORIGIN=*

# MQTT Broker
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=safeguard/uwb
MQTT_USERNAME=
MQTT_PASSWORD=

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_USER_ID=
LINE_ALERT_COOLDOWN_SECONDS=60
SAFETY_ALERT_COOLDOWN_SECONDS=60
PUBLIC_BASE_URL=http://192.168.1.104:5000
