# 可選：IoT API 保護。設定後，ESP32/攝影機須帶 X-API-Key Header。
IOT_API_KEY=change-me
CORS_ORIGIN=*

# MQTT Broker
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=safeguard/uwb
MQTT_USERNAME=
MQTT_PASSWORD=

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_USER_ID=
LINE_ALERT_COOLDOWN_SECONDS=60
SAFETY_ALERT_COOLDOWN_SECONDS=60
PUBLIC_BASE_URL=http://192.168.1.104:5000

# YOLO 獨立辨識服務（SafeGuard 會將介面、API 與串流代理到 /yolo）
YOLO_BACKEND_URL=http://127.0.0.1:8001
YOLO_PROXY_TIMEOUT_SECONDS=10

# UWB 獨立電子圍欄服務（SafeGuard 會將介面與 API 代理到 /site-map）
UWB_BACKEND_URL=http://127.0.0.1:5002
UWB_PROXY_TIMEOUT_SECONDS=10
