# Backend camera source.
# Use a local video, webcam index, RTSP URL, or phone camera HTTP URL.
CAMERA_SOURCE=test_videos/001.mp4
# CAMERA_SOURCE=0
# CAMERA_SOURCE=rtsp://user:password@camera-ip:554/stream
# CAMERA_SOURCE=http://phone-ip:8080
CAMERA_WIDTH=960
CAMERA_HEIGHT=540
CAMERA_TARGET_FPS=30.0
CAMERA_AUTO_CONTRAST=false
CAMERA_DENOISE=false
CAMERA_SHARPEN=false

# YOLO model paths. Relative paths are resolved from the project root.
PERSON_MODEL_PATH=person_v2.pt
EQUIPMENT_MODEL_PATH=best_v3.pt

# Use 1 for the current single-person test videos.
# Set 0 for unlimited people.
MAX_PEOPLE=1
YOLO_IMAGE_SIZE=960

# Higher values make YOLO/MediaPipe update more smoothly, but require more CPU/GPU.
INFERENCE_FPS=30.0
PPE_INTERVAL_SECONDS=2.0
STREAM_JPEG_QUALITY=85

# SafeGuard integration.
CAMERA_ID=CAM-01
CAMERA_LOCATION=預設監控區
YOLO_BACKEND_PORT=8001
SAFEGUARD_FORWARD_ENABLED=true
SAFEGUARD_BASE_URL=http://127.0.0.1:5000
SAFEGUARD_IOT_API_KEY=
SAFEGUARD_FORWARD_TIMEOUT_SECONDS=3
